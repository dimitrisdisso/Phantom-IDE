{
  "name": "phantom-ide",
  "productName": "PHANTOM",
  "version": "1.0.0",
  "description": "PHANTOM — a hacker-workstation IDE built around a floating window system.",
  "main": "main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "npm run test:backend",
    "test:backend": "node tools/backend-test.js",
    "dist": "npx --yes electron-builder@26",
    "test:collab": "node tools/ot-test.js && node tools/collab-test.js",
    "test:p2p": "node tools/p2p-test.js",
    "test:relay": "node tools/relay-test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.4",
    "hyperswarm": "^4.17.2",
    "marked": "^15.0.7",
    "monaco-editor": "0.52.2",
    "mysql2": "^3.12.0",
    "pg": "^8.13.3",
    "sql.js": "^1.12.0",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.0"
  },
  "build": {
    "appId": "dev.phantom.ide",
    "productName": "PHANTOM",
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/sql.js/dist/**",
      "node_modules/udx-native/**",
      "node_modules/sodium-native/**",
      "node_modules/bare-*/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "engines": {
    "node": ">=20.17"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "phantomRelay": "wss://phantom-relay.dimitrisdisso.workers.dev"
}
